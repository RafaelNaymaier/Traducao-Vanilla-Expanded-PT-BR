<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - Drone Factory</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- EN: performance -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/modExtensions/li[@Class="VanillaQuestsExpandedDroneFactory.DroneCapacityLabelsExtension"]/capacityLabels/li[key="Consciousness"]/value</xpath>
          <value>
            <value>desempenho</value>
          </value>
        </li>

        <!-- EN: pneumatics -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/modExtensions/li[@Class="VanillaQuestsExpandedDroneFactory.DroneCapacityLabelsExtension"]/capacityLabels/li[key="BloodFiltration"]/value</xpath>
          <value>
            <value>pneumática</value>
          </value>
        </li>

        <!-- EN: battery integrity -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="VQE_BaseDrone"]/modExtensions/li[@Class="VanillaQuestsExpandedDroneFactory.DroneCapacityLabelsExtension"]/capacityLabels/li[key="BloodPumping"]/value</xpath>
          <value>
            <value>integridade da bateria</value>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>

