<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Plants Expanded - Mushrooms</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Biotech</li>
      </mods>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationConditional">
            <xpath>Defs/ThingDef[defName="VPE_Plant_Toxpuff"]/label</xpath>
            <match Class="PatchOperationReplace">
              <xpath>Defs/ThingDef[defName="VPE_Plant_Toxpuff"]/label</xpath>
              <value><label>cogumelo-tóxico</label></value>
            </match>
          </li>
          <li Class="PatchOperationConditional">
            <xpath>Defs/ThingDef[defName="VPE_Plant_Toxpuff"]/description</xpath>
            <match Class="PatchOperationReplace">
              <xpath>Defs/ThingDef[defName="VPE_Plant_Toxpuff"]/description</xpath>
              <value><description>Cogumelo pequeno, oval e verde, geralmente encontrado em áreas muito poluídas. Libera gás tóxico quando alguém pisa nele.</description></value>
            </match>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
</Patch>
