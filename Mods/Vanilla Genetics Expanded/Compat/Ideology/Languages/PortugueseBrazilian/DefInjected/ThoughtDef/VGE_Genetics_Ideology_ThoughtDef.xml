  <!-- EN: humanoid hybrids in colony -->
  <GR_HumanoidHybrids_Forbidden.stages.humanoid_hybrids_in_colony.label>híbridos humanoides na colônia</GR_HumanoidHybrids_Forbidden.stages.humanoid_hybrids_in_colony.label>

