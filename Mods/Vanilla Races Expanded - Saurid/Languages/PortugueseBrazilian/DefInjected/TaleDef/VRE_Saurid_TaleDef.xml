<LanguageData>

  <VRESaurids_HypothermicReveal.label>Desaceleração Hipotérmica Revelada</VRESaurids_HypothermicReveal.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] freezing to death</li>
    <li>image->[PAWN_nameFull] trudging through snow [circumstance_group]</li>
    <li>image->[PAWN_nameFull] huddled beside a [TerrainFeature] [circumstance_group]</li>
    <li>image->[PAWN_nameFull] searching for a warm [Apparel] [circumstance_group]</li>
    <li>image->[PAWN_nameFull] crouching next to a fire [circumstance_group]</li>
    <li>image->[PAWN_nameFull] trying to light a fire [circumstance_group]</li>
    <li>circumstance_phrase->while [PAWN_possessive] face slowly turns blue</li>
    <li>circumstance_phrase->and shivering uncontrollably</li>
    <li>circumstance_phrase->while covered in frost</li>
    <li>circumstance_phrase->while exhaling clouds of fog</li>
    <li>desc_sentence->[Quantity_adjphrase] frozen [Animal] corpses surround the area.</li>
    <li>desc_sentence->[PAWN_nameDef]'s clothes are tattered and worn.</li>
    <li>desc_sentence->A cold blue moon looms in the background.</li>
    <li>desc_sentence->The scene takes place inside a snow-covered [TreeType] forest.</li>
    <li>desc_sentence->The scene appears to take place inside a freezer.</li>
    <li>desc_sentence->[Quantity_adjphrase] shivering [Animal]s surround the scene.</li>
    <li>desc_sentence->[Quantity_adjphrase] dying [Animal]s lay on the ground.</li>
  -->
  <VRESaurids_HypothermicReveal.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] congelando até a morte</li>
    <li>image->[PAWN_nameFull] caminhando pesadamente pela neve [circumstance_group]</li>
    <li>image->[PAWN_nameFull] encolhido ao lado de um [TerrainFeature] [circumstance_group]</li>
    <li>image->[PAWN_nameFull] procurando por uma [Apparel] quente [circumstance_group]</li>
    <li>image->[PAWN_nameFull] agachado junto a uma fogueira [circumstance_group]</li>
    <li>image->[PAWN_nameFull] tentando acender uma fogueira [circumstance_group]</li>
    <li>circumstance_phrase->enquanto [PAWN_possessive] rosto lentamente fica azul</li>
    <li>circumstance_phrase->e tremendo incontrolavelmente</li>
    <li>circumstance_phrase->enquanto coberto de geada</li>
    <li>circumstance_phrase->enquanto exala nuvens de vapor</li>
    <li>desc_sentence->[Quantity_adjphrase] cadáveres [Animal] congelados cercam a área.</li>
    <li>desc_sentence->As roupas de [PAWN_nameDef] estão esfarrapadas e rasgadas.</li>
    <li>desc_sentence->A cena se passa em um ermo congelado.</li>
    <li>desc_sentence->A cena se passa em uma floresta de [TreeType] coberta de neve.</li>
    <li>desc_sentence->A cena parece se passar dentro de um congelador.</li>
    <li>desc_sentence->[Quantity_adjphrase] animais da espécie [Animal] cercam a cena, tremendo.</li>
    <li>desc_sentence->[Quantity_adjphrase] animais da espécie [Animal] estão morrendo no chão.</li>
  </VRESaurids_HypothermicReveal.rulePack.rulesStrings>

  <VRESaurids_HyperthermicReveal.label>Desaceleração Hipertérmica Revelada</VRESaurids_HyperthermicReveal.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] overheating</li>
    <li>image->[PAWN_nameFull] trudging through sand [circumstance_group]</li>
    <li>image->[PAWN_nameFull] huddled in the shade of a [TerrainFeature] [circumstance_group]</li>
    <li>image->[PAWN_nameFull] searching for water [circumstance_group]</li>
    <li>image->[PAWN_nameFull] searching for shade [circumstance_group]</li>
    <li>image->[PAWN_nameFull] crawling across sun-baked dirt [circumstance_group]</li>
    <li>circumstance_phrase->and covered in sweat</li>
    <li>circumstance_phrase->with cracked dry lips</li>
    <li>circumstance_phrase->while vomiting</li>
    <li>desc_sentence->[Quantity_adjphrase] dessicated [Animal] corpses surround the area.</li>
    <li>desc_sentence->[PAWN_nameDef]'s clothes are tattered and torn.</li>
    <li>desc_sentence->A blazing sun looms in the background.</li>
    <li>desc_sentence->The scene takes place inside a blazing desert.</li>
    <li>desc_sentence->The scene appears to take place inside, next to a heater.</li>
    <li>desc_sentence->[Quantity_adjphrase] unmoving [Animal]s surround the scene.</li>
    <li>desc_sentence->[Quantity_adjphrase] dying [Animal]s lay on the ground.</li>
  -->
  <VRESaurids_HyperthermicReveal.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] superaquecendo</li>
    <li>image->[PAWN_nameFull] caminhando pesadamente pela areia [circumstance_group]</li>
    <li>image->[PAWN_nameFull] encolhido na sombra de um [TerrainFeature] [circumstance_group]</li>
    <li>image->[PAWN_nameFull] procurando água [circumstance_group]</li>
    <li>image->[PAWN_nameFull] procurando sombra [circumstance_group]</li>
    <li>image->[PAWN_nameFull] rastejando pela terra ressecada pelo sol [circumstance_group]</li>
    <li>circumstance_phrase->e coberto de suor</li>
    <li>circumstance_phrase->com lábios rachados e secos</li>
    <li>circumstance_phrase->enquanto vomita</li>
    <li>desc_sentence->[Quantity_adjphrase] cadáveres [Animal] ressecados cercam a área.</li>
    <li>desc_sentence->As roupas de [PAWN_nameDef] estão esfarrapadas e rasgadas.</li>
    <li>desc_sentence->Um sol escaldante paira no fundo.</li>
    <li>desc_sentence->A cena se passa em um deserto em chamas.</li>
    <li>desc_sentence->A cena parece se passar em um interior, ao lado de um aquecedor.</li>
    <li>desc_sentence->[Quantity_adjphrase] animais da espécie [Animal] cercam a cena, imóveis.</li>
    <li>desc_sentence->[Quantity_adjphrase] animais da espécie [Animal] estão morrendo no chão.</li>
  </VRESaurids_HyperthermicReveal.rulePack.rulesStrings>

