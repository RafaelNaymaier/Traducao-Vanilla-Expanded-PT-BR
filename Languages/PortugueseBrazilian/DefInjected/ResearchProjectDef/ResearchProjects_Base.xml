	</Bionics.generalRules.rulesStrings>

	<SniperTurret.generalRules.rulesStrings>
		<li>subject->torretas de precisão</li>
		<li>subject_story->liderou a limpeza após a guerra, recolhendo projéteis de urânio empobrecido radioativo da linha de frente</li>
		<li>subject_story->viu uma torreta atirar diretamente através de um mecanoide de assalto e precisou entender como</li>
		<li>subject_story->pesquisou os efeitos da densidade da munição na armadura</li>
		<li>subject_gerund->construindo torretas de precisão</li>
	</SniperTurret.generalRules.rulesStrings>

	<RocketswarmLauncher.generalRules.rulesStrings>
		<li>subject->lançadores de enxame de foguetes</li>
		<li>subject_story->testemunhou o uso de lançadores de enxame de foguetes contra alvos civis</li>
		<li>subject_story->construiu defesas de último recurso, incluindo armadilhas e lançadores, caso o assentamento fosse ameaçado</li>
		<li>subject_story->começou construindo foguetes primitivos para alcançar o espaço, mas a alta taxa de falha levou-os a serem reaproveitados como armas</li>
		<li>subject_gerund->construindo lançadores de enxame de foguetes</li>
	</RocketswarmLauncher.generalRules.rulesStrings>

	<MultiAnalyzer.generalRules.rulesStrings>
	<li>subject->multianálise</li>
	<li>subject_story->automatizou um laboratório de pesquisa</li>
	<li>subject_story->desvendou os segredos transespectrais do universo</li>
	<li>subject_story->ajudou a identificar novos isótopos estáveis</li>
	<li>subject_gerund->construindo multianalisadores</li>
	</MultiAnalyzer.generalRules.rulesStrings>

	<VitalsMonitor.generalRules.rulesStrings>
	<li>subject->monitoramento de sinais vitais</li>
	<li>subject_story->lutou num hospital superlotado e jurou trabalhar por mudança</li>
	<li>subject_story->cuidou de um sobrevivente de mundo de vidro para que recuperasse a saúde</li>
	<li>subject_story->monitorou a ala de isolamento remotamente, enviando mecanoides para tratamentos</li>
	<li>subject_gerund->monitorando sinais vitais</li>
	<li>subject_gerund->construindo monitores de sinais vitais</li>
	</VitalsMonitor.generalRules.rulesStrings>

	<Fabrication.generalRules.rulesStrings>
	<li>subject->bancadas de fabricação de alta tecnologia</li>
	<li>subject_story->passou muitos anos fabricando componentes avançados, para construir bancadas de fabricação e fabricar mais componentes avançados</li>
	<li>subject_story->trocou tudo para construir uma única bancada de fabricação</li>
	<li>subject_story->construiu maravilhas tecnológicas que os aldeões feriais adoravam como magia</li>
	<li>subject_gerund->construindo projetos de alta tecnologia</li>
	<li>subject_gerund->construindo estações de fabricação de alta tecnologia</li>
	</Fabrication.generalRules.rulesStrings>

	<AdvancedFabrication.generalRules.rulesStrings>
	<li>subject->fabricação de componentes avançados</li>
	<li>subject_story->trocou componentes avançados com habitantes de RimWorld desesperados</li>
	<li>subject_story->aprendeu os segredos da fabricação de componentes avançados e morreu sem os revelar</li>
	<li>subject_story->recuou perante o custo extremo de fabricar componentes avançados e escolheu um estilo de vida mais simples</li>
	<li>subject_gerund->fabricando componentes avançados</li>
	</AdvancedFabrication.generalRules.rulesStrings>

	<Cryptosleep.generalRules.rulesStrings>
	<li>subject->criossono</li>
	<li>subject_story->pretendeu testar um protótipo de cápsula de criossono e acordou uma geração depois, sozinho</li>
	<li>subject_story->sentenciou o pior criminoso do sistema a criossono indefinido em vez de morte</li>
	<li>subject_story->usou uma cápsula de criossono para suspender os doentes terminais, para que pudessem ver os seus filhos depois de crescidos</li>
	<li>subject_gerund->construindo cápsulas de criossono</li>
	<li>subject_gerund->induzindo criossono</li>
	</Cryptosleep.generalRules.rulesStrings>

	<ReconArmor.generalRules.rulesStrings>
	<li>subject->armadura de reconhecimento</li>
	<li>subject_story->liderou os batedores rebeldes contra as forças Imperiais, até ser capturado</li>
	<li>subject_story->fabricou uma armadura motorizada leve e resiliente o suficiente para que os utilizadores de martelos se aproximassem do inimigo</li>
	<li>subject_story->pretendeu armadura de reconhecimento mais para caçadores do que para soldados. Vendeu bem, independentemente</li>
	<li>subject_gerund->fabricando armadura de reconhecimento</li>
	<li>subject_gerund->reduzindo o peso da armadura</li>
	</ReconArmor.generalRules.rulesStrings>

	<PoweredArmor.generalRules.rulesStrings>
	<li>subject->armadura naval</li>
	<li>subject_story->foi empregado pelas tropas de choque para manter a armadura deles</li>
	<li>subject_story->testou a armadura caminhando, desarmado, por uma aldeia feral hostil sem receber um arranhão</li>
	<li>subject_story->pretendeu a armadura como proteção contra o clima hostil do planeta, mas funcionou bem contra os piratas também</li>
	<li>subject_gerund->construindo armadura de tropa de choque</li>
	<li>subject_gerund->construindo armadura naval</li>
	<li>subject_gerund->construindo armadura avançada de uso geral</li>
	</PoweredArmor.generalRules.rulesStrings>

	<ChargedShot.generalRules.rulesStrings>
	<li>subject->munições de pulso</li>
	<li>subject_story->estudou monorails de mundos brilhantes e modificou a tecnologia para armas</li>
	<li>subject_story->matou um rastreador mecânico "kiting-o" (usando a tática de kiting) com uma lança de carga</li>
	<li>subject_story->aprendeu a imbuir munição de espingarda com carga retida, aumentando drasticamente a sua letalidade</li>
	<li>subject_gerund->construindo munições de pulso</li>
	<li>subject_gerund->utilizando munições de pulso</li>
	</ChargedShot.generalRules.rulesStrings>

