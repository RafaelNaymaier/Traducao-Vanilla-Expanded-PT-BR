<LanguageData>

	<Bionics.generalRules.rulesStrings>
		<li>subject_story->estudou vídeos em câmera lenta do movimento humano para criar melhores próteses biônicas</li>
		<li>subject_story->se voluntariou para ter várias próteses biônicas implantadas, acabando mais como máquina do que como humano</li>
		<li>subject_gerund->construindo próteses biônicas</li>
