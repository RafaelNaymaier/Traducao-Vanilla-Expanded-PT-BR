  <!-- EN: The feast has finished. -->
  <VSIE_BingeParty.finishedMessage>A festa terminou.</VSIE_BingeParty.finishedMessage>
  <!-- EN: {ORGANIZER_labelShort} suggests doing a little binge party. Be warned - Binge parties can last up to a few hours. Colonists will binge on food and drugs until it is over. Simply draft your colonists to stop them taking part in the binge party. -->
  <VSIE_BingeParty.letterText>{ORGANIZER_labelShort} sugere fazer uma festa de exageros. Atenção: essas festas podem durar algumas horas. Colonos vão consumir comida e drogas sem parar até a festa acabar. Basta selecionar os colonos para impedir que participem.</VSIE_BingeParty.letterText>
  <!-- EN: Binge party -->
  <VSIE_BingeParty.letterTitle>Festa de exageros</VSIE_BingeParty.letterTitle>

