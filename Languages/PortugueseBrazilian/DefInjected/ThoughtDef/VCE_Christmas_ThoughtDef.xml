  <VCE_Thought_Toy_Teenager.stages.good_toy.label>brinquedo bom</VCE_Thought_Toy_Teenager.stages.good_toy.label>

  <!-- EN: Huh, this is actually kinda nice. Better than I expected. -->
  <VCE_Thought_Toy_Teenager.stages.good_toy.description>Olha, até que isso é legal. Melhor do que eu esperava.</VCE_Thought_Toy_Teenager.stages.good_toy.description>

  <!-- EN: excellent toy -->
  <VCE_Thought_Toy_Teenager.stages.excellent_toy.label>brinquedo excelente</VCE_Thought_Toy_Teenager.stages.excellent_toy.label>

  <!-- EN: Hey, this is a pretty cool toy. I actually like it. -->
  <VCE_Thought_Toy_Teenager.stages.excellent_toy.description>Ei, esse brinquedo é bem legal. Até que eu gostei.</VCE_Thought_Toy_Teenager.stages.excellent_toy.description>

  <!-- EN: masterwork toy -->
  <VCE_Thought_Toy_Teenager.stages.masterwork_toy.label>brinquedo obra-prima</VCE_Thought_Toy_Teenager.stages.masterwork_toy.label>

  <!-- EN: Wow, this toy’s legit amazing. Makes me feel like a kid again. -->
  <VCE_Thought_Toy_Teenager.stages.masterwork_toy.description>Nossa, esse brinquedo é incrível de verdade. Me faz voltar à infância.</VCE_Thought_Toy_Teenager.stages.masterwork_toy.description>

  <!-- EN: legendary toy -->
  <VCE_Thought_Toy_Teenager.stages.legendary_toy.label>brinquedo lendário</VCE_Thought_Toy_Teenager.stages.legendary_toy.label>

  <!-- EN: Okay, this is next level. Like, it’s so good I can’t even pretend not to love it. -->
  <VCE_Thought_Toy_Teenager.stages.legendary_toy.description>Tá, isso está em outro nível. É tão bom que nem dá para fingir que não adorei.</VCE_Thought_Toy_Teenager.stages.legendary_toy.description>

  <!-- EN: festive snow -->
  <VCE_FestiveSnow.stages.festive_snow.label>neve natalina</VCE_FestiveSnow.stages.festive_snow.label>

  <!-- EN: This festive snow sure lifts my spirits. -->
  <VCE_FestiveSnow.stages.festive_snow.description>Essa neve natalina realmente me anima.</VCE_FestiveSnow.stages.festive_snow.description>
