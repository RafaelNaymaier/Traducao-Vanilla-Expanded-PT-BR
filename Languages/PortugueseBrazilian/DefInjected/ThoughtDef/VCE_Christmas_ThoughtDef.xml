  <!-- EN: Whoa! This toy is like magic—it’s so amazing! -->
  <VCE_Thought_Toy_Children.stages.legendary_toy.description>Uau! Esse brinquedo parece mágico, é incrível demais!</VCE_Thought_Toy_Children.stages.legendary_toy.description>

  <!-- EN: awful toy -->
  <VCE_Thought_Toy_Teenager.stages.awful_toy.label>brinquedo horrível</VCE_Thought_Toy_Teenager.stages.awful_toy.label>

  <!-- EN: Ugh, this thing is trash. Why even bother? -->
  <VCE_Thought_Toy_Teenager.stages.awful_toy.description>Aff, que porcaria. Para que perder tempo com isso?</VCE_Thought_Toy_Teenager.stages.awful_toy.description>

  <!-- EN: poor toy -->
  <VCE_Thought_Toy_Teenager.stages.poor_toy.label>brinquedo ruim</VCE_Thought_Toy_Teenager.stages.poor_toy.label>

  <!-- EN: Yeah, okay, this toy kinda sucks, but whatever. -->
  <VCE_Thought_Toy_Teenager.stages.poor_toy.description>Tá, esse brinquedo é meio ruim, mas tanto faz.</VCE_Thought_Toy_Teenager.stages.poor_toy.description>

